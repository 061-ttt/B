{
  "name": "suisan-map",
  "version": "1.0.0",
  "description": "小5社会「水産業のさかんな地域」授業用Webアプリ",
  "scripts": {
    "geo": "node scripts/build-geo.mjs",
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -p . && vite build",
    "build:standalone": "STANDALONE=1 vite build",
    "typecheck": "tsc -p . && tsc -p worker",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy",
    "test:load": "node tests/load/realtime.mjs 60 3",
    "build:gas": "node scripts/build-gas.mjs",
    "test:gas": "node tests/gas/sync-check.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "d3-geo": "^3.1.1",
    "hono": "^4.13.16",
    "jsqr": "^1.4.0",
    "preact": "^11.1.1",
    "qrcode-generator": "^2.0.4",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/d3-geo": "^3.1.1",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "d3-geo-projection": "^4.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "type": "module"
}
